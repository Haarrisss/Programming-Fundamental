#include <iostream>
using namespace std;

int main()
{
    int marks[5], sum = 0;
    float avg;

    for(int i = 0; i < 5; i++)
    {
        cout << "Enter marks: ";
        cin >> marks[i];

        sum = sum + marks[i];
    }

    avg = sum / 5.0;

    cout << "Average = " << avg;

    return 0;
}
